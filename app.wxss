page {
    min-height: 100%;
    background: #f5f7fa;
    color: #1f2329;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
    padding: 24rpx 28rpx 48rpx;
}

.page-header {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
    margin-bottom: 24rpx;
}

.page-title {
    font-size: 40rpx;
    font-weight: 500;
    color: #1a1d23;
}

.page-subtitle {
    font-size: 24rpx;
    color: #8a8f99;
}

.section-title {
    font-size: 28rpx;
    font-weight: 500;
    color: #1a1d23;
    margin: 28rpx 0 16rpx;
}

.card {
    background: #ffffff;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
}

.muted {
    color: #8a8f99;
    font-size: 24rpx;
}

.small {
    font-size: 22rpx;
    color: #9a9ea6;
}

.row {
    display: flex;
    align-items: center;
}

.row-between {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.chip {
    display: inline-flex;
    align-items: center;
    padding: 8rpx 20rpx;
    border-radius: 999rpx;
    font-size: 24rpx;
    color: #5f646d;
    background: #ffffff;
    border: 1rpx solid #e3e6ec;
}

.chip-active {
    background: #e6f1fb;
    color: #185fa5;
    border-color: #b5d4f4;
}

.badge {
    display: inline-flex;
    align-items: center;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
    font-size: 20rpx;
    background: #f1f3f6;
    color: #6b717a;
}

.badge-gap {
    background: #faeeda;
    color: #854f0b;
}

.badge-revision {
    background: #eeedfe;
    color: #534ab7;
}

.badge-primary {
    background: #f5c4b3;
    color: #993c1d;
}

.notice {
    background: #faeeda;
    border-radius: 16rpx;
    padding: 18rpx 22rpx;
    font-size: 24rpx;
    color: #854f0b;
    margin-bottom: 20rpx;
}

.notice-error {
    background: #fcebeb;
    color: #a32d2d;
}

.link {
    color: #185fa5;
    font-size: 24rpx;
}

.primary-button {
    background: #185fa5;
    color: #ffffff;
    border-radius: 12rpx;
    font-size: 28rpx;
}

.ghost-button {
    background: #ffffff;
    color: #185fa5;
    border: 1rpx solid #b5d4f4;
    border-radius: 12rpx;
    font-size: 26rpx;
}

.state-card {
    background: #ffffff;
    border-radius: 20rpx;
    padding: 48rpx 28rpx;
    text-align: center;
    margin-bottom: 20rpx;
}

.state-title {
    display: block;
    font-size: 28rpx;
    margin-bottom: 10rpx;
}

.state-desc {
    display: block;
    font-size: 24rpx;
    color: #8a8f99;
    margin-bottom: 24rpx;
}

.divider {
    height: 1rpx;
    background: #eef0f4;
    margin: 16rpx 0;
}
