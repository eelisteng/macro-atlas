# 复制本文件为 .env.local 并填入真实值，然后执行 `npm run setup`。
# .env.local 已被 .gitignore 排除，绝不要提交。
# 显式 export 的同名环境变量优先级高于 .env.local，适合 CI / 云端构建。
#
# 取值来源：
#   WX_APPID              mp.weixin.qq.com → 开发管理 → 开发设置 → 开发者ID → AppID(小程序ID)
#   WB_CLOUD_ENDPOINT     WorkBuddy 云服务激活后 publicConfig.endpoint（https:// 开头，不带路径）
#   WB_PUBLISHABLE_KEY    WorkBuddy 云服务 publicConfig.publishableKey
#   WB_OAUTH_CLIENT_ID    WorkBuddy 云服务 publicConfig.workBuddyOAuthClientId

WX_APPID=
WB_CLOUD_ENDPOINT=
WB_PUBLISHABLE_KEY=
WB_OAUTH_CLIENT_ID=
