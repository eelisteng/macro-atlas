.chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-bottom: 24rpx;
}

.intro-card {
    background: #e6f1fb;
    border-radius: 20rpx;
    padding: 24rpx;
    display: flex;
    flex-direction: column;
    gap: 10rpx;
    margin-bottom: 24rpx;
}

.intro-name {
    font-size: 30rpx;
    font-weight: 500;
    color: #0c447c;
}

.chart-card {
    background: #ffffff;
    border-radius: 20rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
}

.chart-title {
    font-size: 28rpx;
    font-weight: 500;
}

.chart-caliber {
    display: block;
    font-size: 20rpx;
    color: #9a9ea6;
    margin: 8rpx 0 12rpx;
}

.ind-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16rpx 0;
    border-bottom: 1rpx solid #eef0f4;
}

.ind-row:last-child {
    border-bottom: none;
}

.ind-left {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
    flex: 1;
    min-width: 0;
}

.ind-name {
    font-size: 26rpx;
}
